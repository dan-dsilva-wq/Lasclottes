/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; frame-src https://www.google.com; connect-src 'self'; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Keep the permanent technical staging hostname out of search results. This
# host-specific rule does not apply to lasclottes.com after the live cutover.
https://lasclottes.super-bread-8b96.workers.dev/*
  X-Robots-Tag: noindex

/data/availability.json
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/css/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=604800

/Media/*
  Cache-Control: public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=604800
