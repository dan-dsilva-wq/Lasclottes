{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lasclottes",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api/*",
      "/fr",
      "/nl"
    ]
  }
}
