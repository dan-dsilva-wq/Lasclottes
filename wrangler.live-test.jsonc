{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lasclottes",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "test.lasclottes.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://test.lasclottes.com",
    "BOOKING_PAYMENTS_ENABLED": "true",
    "BOOKING_EMAILS_ENABLED": "true",
    "BOOKING_TERMS_APPROVED": "false",
    "BOOKING_OWNER_EMAIL": "sallyaspencer@icloud.com",
    "BOOKING_MONITOR_EMAILS": "dan-dsilva@outlook.com",
    "BOOKING_SENDER_EMAIL": "bookings@lasclottes.com",
    "RESEND_EMAIL_DOMAIN": "lasclottes.com",
    "WIX_SITE_BASE_URLS": "https://www.lasclottes.com,https://lasclottes.com",
    "WIX_BOOKING_TEST_MODE": "true",
    "WIX_LIVE_PAYMENTS": "false",
    "STRIPE_LIVE_WEBHOOKS_ON_SHARED_ENDPOINT": "false",
    "WIX_STRIPE_SUCCESS_URL": "https://www.lasclottes.com/payment-success",
    "WIX_STRIPE_CANCEL_URL": "https://www.lasclottes.com/payment-cancelled"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api/*",
      "/fr",
      "/nl"
    ]
  }
}
