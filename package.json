{
  "name": "lasclottes-booking-site",
  "version": "1.0.0",
  "private": true,
  "description": "Lasclottes website and portable booking backend",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:js": "esbuild js/main_old.js --minify --outfile=js/main.js",
    "build:css": "esbuild css/style_old.css --minify --outfile=css/style.css",
    "build:cloudflare": "node scripts/build-cloudflare.cjs",
    "check:cloudflare": "npm run build:cloudflare && wrangler deploy --dry-run",
    "readiness": "node scripts/launch-readiness.cjs",
    "audit:deployment": "node scripts/audit-deployment.cjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.32.0"
  },
  "engines": {
    "node": ">=20"
  }
}
